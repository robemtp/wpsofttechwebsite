<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ATALASafety Promo</title>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
:root {
  --accent: #00d4aa;
  --accent-glow: rgba(0,212,170,0.3);
  --dark: #0a0e1a;
  --darker: #060912;
  --card: rgba(255,255,255,0.04);
  --card-border: rgba(255,255,255,0.08);
  --text: #ffffff;
  --text-dim: rgba(255,255,255,0.5);
}
html, body { width:100%; height:100%; overflow:hidden; background:var(--darker); font-family:'Sora',sans-serif; color:var(--text); }

#canvas { position:fixed; inset:0; display:flex; align-items:center; justify-content:center; background:var(--darker); }

.bg-orb { position:fixed; border-radius:50%; filter:blur(120px); opacity:0; transition:opacity 1.5s ease; pointer-events:none; }
.bg-orb.visible { opacity:1; }
.bg-orb-1 { width:600px; height:600px; background:rgba(0,212,170,0.08); top:-10%; left:-10%; }
.bg-orb-2 { width:500px; height:500px; background:rgba(0,140,255,0.06); bottom:-10%; right:-5%; }
.bg-orb-3 { width:400px; height:400px; background:rgba(0,212,170,0.05); top:50%; left:60%; transform:translate(-50%,-50%); }

.grid-bg {
  position:fixed; inset:0;
  background-image: linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
  background-size:60px 60px; opacity:0; transition:opacity 2s ease;
}
.grid-bg.visible { opacity:1; }

/* Slides */
.slide {
  position:absolute; width:100%; height:100%;
  display:flex; align-items:center; justify-content:center; flex-direction:column;
  opacity:0; transform:scale(0.96);
  transition: opacity 0.9s cubic-bezier(.4,0,.2,1), transform 0.9s cubic-bezier(.4,0,.2,1);
  pointer-events:none;
}
.slide.active { opacity:1; transform:scale(1); pointer-events:auto; }

/* S1: Logo */
.logo-shield { width:120px; height:140px; margin-bottom:32px; opacity:0; transform:translateY(30px) scale(0.8); transition:all 1s cubic-bezier(.16,1,.3,1) 0.3s; }
.slide.active .logo-shield { opacity:1; transform:translateY(0) scale(1); }
.logo-wordmark { font-size:56px; font-weight:800; letter-spacing:-2px; opacity:0; transform:translateY(20px); transition:all 0.8s cubic-bezier(.16,1,.3,1) 0.7s; }
.slide.active .logo-wordmark { opacity:1; transform:translateY(0); }
.logo-wordmark .accent { color:var(--accent); }
.logo-tagline { font-size:18px; font-weight:300; color:var(--text-dim); letter-spacing:4px; text-transform:uppercase; margin-top:16px; opacity:0; transform:translateY(15px); transition:all 0.8s cubic-bezier(.16,1,.3,1) 1.1s; }
.slide.active .logo-tagline { opacity:1; transform:translateY(0); }
@keyframes pulseGlow { 0%,100%{filter:drop-shadow(0 0 8px var(--accent-glow));} 50%{filter:drop-shadow(0 0 20px var(--accent-glow));} }
.slide.active .logo-shield svg { animation:pulseGlow 3s ease-in-out infinite; }

/* S2: Problem */
.problem-text { font-size:38px; font-weight:300; line-height:1.5; text-align:center; max-width:800px; padding:0 40px; }
.problem-text em { font-style:normal; color:var(--accent); font-weight:600; }
.problem-text .line { display:block; opacity:0; transform:translateY(25px); transition:all 0.7s cubic-bezier(.16,1,.3,1); }
.slide.active .problem-text .line:nth-child(1) { opacity:1; transform:translateY(0); transition-delay:0.2s; }
.slide.active .problem-text .line:nth-child(2) { opacity:1; transform:translateY(0); transition-delay:0.5s; }
.slide.active .problem-text .line:nth-child(3) { opacity:1; transform:translateY(0); transition-delay:0.8s; }

/* S3: Acronym */
.acronym-wrap { display:flex; flex-direction:column; gap:14px; padding:0 40px; }
.acronym-row { display:flex; align-items:center; gap:16px; opacity:0; transform:translateX(-40px); transition:all 0.6s cubic-bezier(.16,1,.3,1); }
.slide.active .acronym-row:nth-child(1) { opacity:1; transform:translateX(0); transition-delay:0.2s; }
.slide.active .acronym-row:nth-child(2) { opacity:1; transform:translateX(0); transition-delay:0.4s; }
.slide.active .acronym-row:nth-child(3) { opacity:1; transform:translateX(0); transition-delay:0.6s; }
.slide.active .acronym-row:nth-child(4) { opacity:1; transform:translateX(0); transition-delay:0.8s; }
.slide.active .acronym-row:nth-child(5) { opacity:1; transform:translateX(0); transition-delay:1.0s; }
.acronym-letter { font-size:52px; font-weight:800; color:var(--accent); width:64px; text-align:center; flex-shrink:0; }
.acronym-word { font-size:28px; font-weight:400; }

/* S4: Modules */
.module-slide-title { font-size:16px; font-weight:500; color:var(--accent); letter-spacing:3px; text-transform:uppercase; margin-bottom:36px; opacity:0; transform:translateY(15px); transition:all 0.6s ease 0.1s; }
.slide.active .module-slide-title { opacity:1; transform:translateY(0); }
.module-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; max-width:820px; padding:0 40px; }
.module-chip { background:var(--card); border:1px solid var(--card-border); border-radius:12px; padding:14px 20px; font-size:14px; font-weight:500; text-align:center; display:flex; align-items:center; justify-content:center; gap:8px; opacity:0; transform:translateY(20px) scale(0.9); transition:all 0.5s cubic-bezier(.16,1,.3,1); white-space:nowrap; }
.module-chip .chip-icon { font-size:18px; }
.slide.active .module-chip { opacity:1; transform:translateY(0) scale(1); }
.slide.active .module-chip:nth-child(1){transition-delay:.08s} .slide.active .module-chip:nth-child(2){transition-delay:.12s}
.slide.active .module-chip:nth-child(3){transition-delay:.16s} .slide.active .module-chip:nth-child(4){transition-delay:.20s}
.slide.active .module-chip:nth-child(5){transition-delay:.24s} .slide.active .module-chip:nth-child(6){transition-delay:.28s}
.slide.active .module-chip:nth-child(7){transition-delay:.32s} .slide.active .module-chip:nth-child(8){transition-delay:.36s}
.slide.active .module-chip:nth-child(9){transition-delay:.40s} .slide.active .module-chip:nth-child(10){transition-delay:.44s}
.slide.active .module-chip:nth-child(11){transition-delay:.48s} .slide.active .module-chip:nth-child(12){transition-delay:.52s}
.slide.active .module-chip:nth-child(13){transition-delay:.56s} .slide.active .module-chip:nth-child(14){transition-delay:.60s}
.slide.active .module-chip:nth-child(15){transition-delay:.64s} .slide.active .module-chip:nth-child(16){transition-delay:.68s}
.module-count { font-size:14px; color:var(--text-dim); margin-top:28px; opacity:0; transition:all 0.6s ease 0.9s; }
.slide.active .module-count { opacity:1; }

/* S5: Dashboard preview */
.preview-label { font-size:14px; font-weight:500; color:var(--accent); letter-spacing:3px; text-transform:uppercase; margin-bottom:20px; opacity:0; transform:translateY(12px); transition:all 0.6s ease 0.1s; }
.slide.active .preview-label { opacity:1; transform:translateY(0); }

.dash-frame {
  width:920px; height:520px; background:#0d1117; border-radius:14px;
  border:1px solid rgba(255,255,255,0.08); overflow:hidden; display:flex;
  box-shadow:0 30px 80px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.05);
  opacity:0; transform:translateY(30px) scale(0.95);
  transition:all 1s cubic-bezier(.16,1,.3,1) 0.25s;
}
.slide.active .dash-frame { opacity:1; transform:translateY(0) scale(1); }

.dash-sidebar { width:200px; background:#090d14; border-right:1px solid rgba(255,255,255,0.06); padding:16px 0; flex-shrink:0; display:flex; flex-direction:column; }
.dash-sidebar-logo { padding:4px 16px 20px; font-size:15px; font-weight:700; border-bottom:1px solid rgba(255,255,255,0.06); margin-bottom:12px; }
.dash-sidebar-logo .sa { color:var(--accent); }
.dash-nav-item { padding:9px 16px; font-size:12px; color:rgba(255,255,255,0.4); display:flex; align-items:center; gap:10px; cursor:default; }
.dash-nav-item.active { color:#fff; background:rgba(0,212,170,0.08); border-left:2px solid var(--accent); }
.dash-nav-item .nav-icon { font-size:14px; width:20px; text-align:center; }

.dash-main { flex:1; padding:20px 24px; overflow:hidden; display:flex; flex-direction:column; }
.dash-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; }
.dash-title { font-size:18px; font-weight:700; }
.dash-date { font-size:11px; color:var(--text-dim); }

.dash-stats { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:18px; }
.dash-stat-card { background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06); border-radius:10px; padding:14px; opacity:0; transform:translateY(12px); transition:all 0.5s cubic-bezier(.16,1,.3,1); }
.slide.active .dash-stat-card { opacity:1; transform:translateY(0); }
.slide.active .dash-stat-card:nth-child(1){transition-delay:.5s} .slide.active .dash-stat-card:nth-child(2){transition-delay:.6s}
.slide.active .dash-stat-card:nth-child(3){transition-delay:.7s} .slide.active .dash-stat-card:nth-child(4){transition-delay:.8s}

.dsc-label { font-size:10px; color:var(--text-dim); text-transform:uppercase; letter-spacing:1px; margin-bottom:6px; }
.dsc-value { font-size:26px; font-weight:800; }
.dsc-value.green{color:var(--accent)} .dsc-value.amber{color:#f59e0b} .dsc-value.red{color:#ef4444} .dsc-value.blue{color:#3b82f6}
.dsc-sub { font-size:9px; color:var(--text-dim); margin-top:3px; }

.dash-bottom { display:grid; grid-template-columns:1fr 1fr; gap:14px; flex:1; }
.dash-chart-card { background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06); border-radius:10px; padding:14px; opacity:0; transform:translateY(12px); transition:all 0.6s cubic-bezier(.16,1,.3,1) 0.9s; }
.slide.active .dash-chart-card { opacity:1; transform:translateY(0); }
.dcc-title { font-size:11px; font-weight:600; margin-bottom:12px; }
.mini-bars { display:flex; align-items:flex-end; gap:8px; height:140px; padding-top:8px; }
.mini-bar-col { flex:1; display:flex; flex-direction:column; align-items:center; gap:4px; height:100%; justify-content:flex-end; }
.mini-bar { width:100%; border-radius:4px 4px 0 0; transition:height 1s cubic-bezier(.16,1,.3,1); height:0; }
.mini-bar-label { font-size:8px; color:var(--text-dim); }

.dash-table-card { background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06); border-radius:10px; padding:14px; opacity:0; transform:translateY(12px); transition:all 0.6s cubic-bezier(.16,1,.3,1) 1.0s; }
.slide.active .dash-table-card { opacity:1; transform:translateY(0); }
.dtc-title { font-size:11px; font-weight:600; margin-bottom:10px; }
.dtc-row { display:flex; justify-content:space-between; align-items:center; padding:7px 0; border-bottom:1px solid rgba(255,255,255,0.04); font-size:10px; }
.dtc-row:last-child { border-bottom:none; }
.dtc-id { color:var(--accent); font-weight:600; width:60px; }
.dtc-desc { flex:1; color:rgba(255,255,255,0.6); margin:0 10px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.dtc-badge { font-size:9px; padding:2px 8px; border-radius:99px; font-weight:600; }
.badge-open{background:rgba(239,68,68,0.15);color:#ef4444} .badge-progress{background:rgba(245,158,11,0.15);color:#f59e0b}
.badge-closed{background:rgba(0,212,170,0.15);color:var(--accent)} .badge-review{background:rgba(59,130,246,0.15);color:#3b82f6}

/* S6: AI */
.ai-wrap { text-align:center; max-width:700px; padding:0 40px; }
.ai-badge { display:inline-flex; align-items:center; gap:8px; background:rgba(0,212,170,0.1); border:1px solid rgba(0,212,170,0.2); border-radius:100px; padding:8px 20px; font-size:13px; font-weight:600; color:var(--accent); letter-spacing:2px; text-transform:uppercase; margin-bottom:28px; opacity:0; transform:translateY(15px); transition:all 0.7s ease 0.2s; }
.slide.active .ai-badge { opacity:1; transform:translateY(0); }
.ai-title { font-size:42px; font-weight:700; line-height:1.3; margin-bottom:20px; opacity:0; transform:translateY(20px); transition:all 0.7s ease 0.5s; }
.slide.active .ai-title { opacity:1; transform:translateY(0); }
.ai-desc { font-size:18px; font-weight:300; color:var(--text-dim); line-height:1.6; opacity:0; transform:translateY(15px); transition:all 0.7s ease 0.8s; }
.slide.active .ai-desc { opacity:1; transform:translateY(0); }

/* S7: Stats */
.stats-row { display:flex; gap:60px; margin-bottom:40px; }
.stat-item { text-align:center; opacity:0; transform:translateY(25px); transition:all 0.7s cubic-bezier(.16,1,.3,1); }
.slide.active .stat-item:nth-child(1){opacity:1;transform:translateY(0);transition-delay:.2s}
.slide.active .stat-item:nth-child(2){opacity:1;transform:translateY(0);transition-delay:.4s}
.slide.active .stat-item:nth-child(3){opacity:1;transform:translateY(0);transition-delay:.6s}
.stat-number { font-size:56px; font-weight:800; color:var(--accent); line-height:1; }
.stat-label { font-size:14px; font-weight:400; color:var(--text-dim); margin-top:8px; letter-spacing:1px; text-transform:uppercase; }
.stats-sub { font-size:20px; font-weight:300; color:var(--text-dim); opacity:0; transition:all 0.6s ease 0.9s; }
.slide.active .stats-sub { opacity:1; }

/* S8: CTA */
.cta-wrap { text-align:center; }
.cta-headline { font-size:48px; font-weight:700; line-height:1.3; margin-bottom:24px; opacity:0; transform:translateY(25px); transition:all 0.8s cubic-bezier(.16,1,.3,1) 0.2s; }
.slide.active .cta-headline { opacity:1; transform:translateY(0); }
.cta-headline .accent { color:var(--accent); }
.cta-url { display:inline-flex; align-items:center; gap:10px; background:var(--accent); color:var(--dark); font-size:20px; font-weight:700; padding:16px 40px; border-radius:60px; letter-spacing:0.5px; opacity:0; transform:translateY(20px); transition:all 0.8s cubic-bezier(.16,1,.3,1) 0.6s; }
.slide.active .cta-url { opacity:1; transform:translateY(0); }
.cta-sub { font-size:14px; color:var(--text-dim); margin-top:20px; letter-spacing:2px; text-transform:uppercase; opacity:0; transition:all 0.6s ease 0.9s; }
.slide.active .cta-sub { opacity:1; }

#progress { position:fixed; bottom:0; left:0; height:3px; background:var(--accent); z-index:100; transition:width 0.3s linear; }
#controls { position:fixed; bottom:20px; right:20px; display:flex; gap:8px; z-index:100; }
#controls button { background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.15); color:white; font-family:'Sora',sans-serif; font-size:12px; padding:8px 16px; border-radius:8px; cursor:pointer; transition:background 0.2s; }
#controls button:hover { background:rgba(255,255,255,0.15); }
</style>
</head>
<body>
<div id="canvas">
  <div class="bg-orb bg-orb-1" id="orb1"></div>
  <div class="bg-orb bg-orb-2" id="orb2"></div>
  <div class="bg-orb bg-orb-3" id="orb3"></div>
  <div class="grid-bg" id="gridBg"></div>

  <!-- S1: Logo -->
  <div class="slide" id="slide-0">
    <div class="logo-shield">
      <svg viewBox="0 0 120 140" xmlns="http://www.w3.org/2000/svg">
        <defs><linearGradient id="shieldGrad" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#00d4aa"/><stop offset="100%" stop-color="#00a388"/></linearGradient></defs>
        <path d="M60 5 L110 30 L110 80 Q110 120 60 135 Q10 120 10 80 L10 30 Z" fill="none" stroke="url(#shieldGrad)" stroke-width="3"/>
        <path d="M60 20 L95 38 L95 75 Q95 108 60 120 Q25 108 25 75 L25 38 Z" fill="url(#shieldGrad)" opacity="0.12"/>
        <text x="60" y="68" text-anchor="middle" font-family="Sora,sans-serif" font-weight="800" font-size="22" fill="#00d4aa">ATALA</text>
        <text x="60" y="88" text-anchor="middle" font-family="Sora,sans-serif" font-weight="400" font-size="11" fill="rgba(255,255,255,0.5)" letter-spacing="3">SAFETY</text>
      </svg>
    </div>
    <div class="logo-wordmark">ATALA<span class="accent">Safety</span></div>
    <div class="logo-tagline">Health · Safety · Environment · Quality</div>
  </div>

  <!-- S2: Problem -->
  <div class="slide" id="slide-1">
    <div class="problem-text">
      <span class="line">Spreadsheets weren't built for safety.</span>
      <span class="line">Clipboards can't track compliance.</span>
      <span class="line">Your team deserves <em>better</em>.</span>
    </div>
  </div>

  <!-- S3: Acronym -->
  <div class="slide" id="slide-2">
    <div class="acronym-wrap">
      <div class="acronym-row"><span class="acronym-letter">A</span><span class="acronym-word">Alert</span></div>
      <div class="acronym-row"><span class="acronym-letter">T</span><span class="acronym-word">Track</span></div>
      <div class="acronym-row"><span class="acronym-letter">A</span><span class="acronym-word">Analyze</span></div>
      <div class="acronym-row"><span class="acronym-letter">L</span><span class="acronym-word">Learn</span></div>
      <div class="acronym-row"><span class="acronym-letter">A</span><span class="acronym-word">Adapt</span></div>
    </div>
  </div>

  <!-- S4: Modules -->
  <div class="slide" id="slide-3">
    <div class="module-slide-title">Everything in One Platform</div>
    <div class="module-grid">
      <div class="module-chip"><span class="chip-icon">📋</span> Incidents</div>
      <div class="module-chip"><span class="chip-icon">🔍</span> Audits</div>
      <div class="module-chip"><span class="chip-icon">📝</span> Permits</div>
      <div class="module-chip"><span class="chip-icon">⚠️</span> JSA</div>
      <div class="module-chip"><span class="chip-icon">📊</span> Risk Assessment</div>
      <div class="module-chip"><span class="chip-icon">🎓</span> Training / LMS</div>
      <div class="module-chip"><span class="chip-icon">🔄</span> CAPA</div>
      <div class="module-chip"><span class="chip-icon">🏭</span> Industrial Hygiene</div>
      <div class="module-chip"><span class="chip-icon">⚗️</span> SDS / Chemicals</div>
      <div class="module-chip"><span class="chip-icon">👁️</span> Observations</div>
      <div class="module-chip"><span class="chip-icon">🔧</span> Asset Register</div>
      <div class="module-chip"><span class="chip-icon">📑</span> Document Control</div>
      <div class="module-chip"><span class="chip-icon">✅</span> Compliance Tasks</div>
      <div class="module-chip"><span class="chip-icon">🔀</span> Mgmt of Change</div>
      <div class="module-chip"><span class="chip-icon">👷</span> Contractor Mgmt</div>
      <div class="module-chip"><span class="chip-icon">📈</span> Quality</div>
    </div>
    <div class="module-count">16+ integrated modules — and growing</div>
  </div>

  <!-- S5: Dashboard Preview -->
  <div class="slide" id="slide-4">
    <div class="preview-label">Live Platform Preview</div>
    <div class="dash-frame">
      <div class="dash-sidebar">
        <div class="dash-sidebar-logo">ATALA<span class="sa">Safety</span></div>
        <div class="dash-nav-item active"><span class="nav-icon">📊</span> Dashboard</div>
        <div class="dash-nav-item"><span class="nav-icon">📋</span> Incidents</div>
        <div class="dash-nav-item"><span class="nav-icon">🔍</span> Audits</div>
        <div class="dash-nav-item"><span class="nav-icon">📝</span> Permits</div>
        <div class="dash-nav-item"><span class="nav-icon">⚠️</span> JSA</div>
        <div class="dash-nav-item"><span class="nav-icon">📊</span> Risk Assessment</div>
        <div class="dash-nav-item"><span class="nav-icon">🎓</span> Training</div>
        <div class="dash-nav-item"><span class="nav-icon">🔄</span> CAPA</div>
        <div class="dash-nav-item"><span class="nav-icon">⚗️</span> Chemicals / SDS</div>
