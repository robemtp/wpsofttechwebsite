<div id="progress" style="width:0%"></div>
<div id="controls">
  <button onclick="restart()">⟳ Restart</button>
  <button onclick="togglePause()">⏸ Pause</button>
</div>

<script>
var SLIDE_DURATION = [3800, 4200, 4500, 4200, 5500, 4000, 3500, 4000];
var TOTAL_DURATION = SLIDE_DURATION.reduce(function(a,b){return a+b},0);
var currentSlide=-1, paused=false, timer=null, startTime=0, elapsed=0, progressRAF=null, barAnimated=false;

function showSlide(n){
  var slides=document.querySelectorAll('.slide');
  for(var i=0;i<slides.length;i++){if(i===n)slides[i].classList.add('active');else slides[i].classList.remove('active');}
  currentSlide=n;
  if(n>=1){document.querySelectorAll('.bg-orb').forEach(function(o){o.classList.add('visible')});document.getElementById('gridBg').classList.add('visible');}
  if(n===4&&!barAnimated){barAnimated=true;setTimeout(function(){document.querySelectorAll('.mini-bar').forEach(function(b){b.style.height=b.getAttribute('data-h')+'%'})},800);}
}
function advanceSlide(){var next=currentSlide+1;if(next>=SLIDE_DURATION.length)return;showSlide(next);timer=setTimeout(advanceSlide,SLIDE_DURATION[next]);}
function updateProgress(){if(paused)return;elapsed=Date.now()-startTime;var pct=Math.min((elapsed/TOTAL_DURATION)*100,100);document.getElementById('progress').style.width=pct+'%';if(pct<100)progressRAF=requestAnimationFrame(updateProgress);}
function start(){currentSlide=-1;barAnimated=false;startTime=Date.now();elapsed=0;advanceSlide();updateProgress();}
function restart(){clearTimeout(timer);cancelAnimationFrame(progressRAF);document.querySelectorAll('.slide').forEach(function(s){s.classList.remove('active')});document.querySelectorAll('.bg-orb').forEach(function(o){o.classList.remove('visible')});document.getElementById('gridBg').classList.remove('visible');document.getElementById('progress').style.width='0%';document.querySelectorAll('.mini-bar').forEach(function(b){b.style.height='0'});paused=false;setTimeout(start,400);}
function togglePause(){paused=!paused;if(paused){clearTimeout(timer);cancelAnimationFrame(progressRAF)}else{startTime=Date.now()-elapsed;var remaining=SLIDE_DURATION[currentSlide]-1000;timer=setTimeout(advanceSlide,Math.max(remaining,500));updateProgress();}}
setTimeout(start,600);
</script>
