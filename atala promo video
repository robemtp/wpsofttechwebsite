        <div class="dash-nav-item"><span class="nav-icon">🔧</span> Assets</div>
        <div class="dash-nav-item"><span class="nav-icon">✅</span> Compliance</div>
        <div class="dash-nav-item"><span class="nav-icon">⚙️</span> Settings</div>
      </div>
      <div class="dash-main">
        <div class="dash-header">
          <div class="dash-title">Safety Dashboard</div>
          <div class="dash-date">May 2026</div>
        </div>
        <div class="dash-stats">
          <div class="dash-stat-card"><div class="dsc-label">Open Incidents</div><div class="dsc-value red">7</div><div class="dsc-sub">▼ 2 from last month</div></div>
          <div class="dash-stat-card"><div class="dsc-label">Pending Audits</div><div class="dsc-value amber">4</div><div class="dsc-sub">Next: May 22</div></div>
          <div class="dash-stat-card"><div class="dsc-label">Training Compliance</div><div class="dsc-value green">94%</div><div class="dsc-sub">▲ 3% improvement</div></div>
          <div class="dash-stat-card"><div class="dsc-label">Active Permits</div><div class="dsc-value blue">12</div><div class="dsc-sub">3 expiring this week</div></div>
        </div>
        <div class="dash-bottom">
          <div class="dash-chart-card">
